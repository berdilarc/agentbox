#!/usr/bin/env bash
#
# Run a command in a microsandbox VM built from localhost/agentbox:latest,
# with the current directory mounted at the same path.
#
# Usage: agentbox [--admin] [command [args...]]
#   e.g. agentbox, agentbox --admin mise install
#
#   --admin  Admin mode: mount the shared mise directories writable, to
#            install toolchains and trust project configurations. Runs
#            bash if no command is given. Don't run agents in this mode.
#
# Without --admin, runs claude if no command is given.
#
# Environment:
#   AGENTBOX_GH_TOKEN  GitHub token. msb substitutes it only in requests to
#                      api.github.com and github.com; the VM never sees it.
#   AGENTBOX_CLAUDE_CODE_OAUTH_TOKEN
#                      Claude Code OAuth token, from `claude setup-token`.
#                      msb substitutes it only in requests to
#                      api.anthropic.com; the VM never sees it.
#   AGENTBOX_CLOUDSDK_AUTH_ACCESS_TOKEN
#                      Google Cloud access token, e.g. from
#                      `gcloud auth print-access-token`. The VM gets it as
#                      CLOUDSDK_AUTH_ACCESS_TOKEN for gcloud and as
#                      GOOGLE_OAUTH_ACCESS_TOKEN for Terraform. msb
#                      substitutes it only in requests to *.googleapis.com;
#                      the VM never sees it.
#   AGENTBOX_DATA_DIR  Host directory for agent state, with claude/,
#                      mise/{data,config,state} and cache/{admin,projects}.
#                      Default: ~/.local/share/agentbox.
#   AGENTBOX_SHARE_TZ  If set to any non-empty value, set TZ in the VM to
#                      the host's timezone: $TZ if set, otherwise the zone
#                      that /etc/localtime links to.
#   AGENTBOX_SHARE_DIRS
#                      Space-separated names of host variables that hold
#                      directory paths, e.g. "TF_PLUGIN_CACHE_DIR". Each
#                      set variable is passed to the VM and its directory
#                      is mounted read-only at the same path.
#
# Requires: msb

set -euo pipefail

is_admin=
if [[ ${1-} == --admin ]]; then
  is_admin=1
  shift
  (($# == 0)) && set -- bash
fi
(($# == 0)) && set -- claude

AGENTBOX_DATA_DIR="${AGENTBOX_DATA_DIR:-$HOME/.local/share/agentbox}"
mise_dir="$AGENTBOX_DATA_DIR/mise"
mkdir -p "$AGENTBOX_DATA_DIR/claude" "$mise_dir/data" "$mise_dir/config" "$mise_dir/state"

# Agent sessions can't change the shared toolchains, the global mise
# configuration or the trust record. Paranoid mode ties trust to the
# file's content hash, so an agent's edit untrusts it. Auto-install is
# off in agent sessions because it would fail against the read-only
# data directory; install tools in admin mode.
vm_env=(MISE_PARANOID=1)
if [[ -n "$is_admin" ]]; then
  mise_mount_suffix=
else
  mise_mount_suffix=:ro
  vm_env+=(MISE_AUTO_INSTALL=false)
fi

# The VM defaults to UTC. Pass the host's zone name, which the image's
# tzdata resolves.
if [[ -n "${AGENTBOX_SHARE_TZ-}" ]]; then
  host_tz="${TZ:-$(readlink -f /etc/localtime 2>/dev/null)}"
  host_tz="${host_tz#*/zoneinfo/}"
  if [[ -n "$host_tz" ]]; then
    vm_env+=("TZ=$host_tz")
  else
    echo "agentbox: can't determine the host's timezone; using UTC" >&2
  fi
fi

# Host directories named by variables, mounted read-only at the same path
# so the variable's value stays valid in the VM.
shared_dirs=()
read -ra share_dir_names <<<"${AGENTBOX_SHARE_DIRS-}"
for name in "${share_dir_names[@]}"; do
  if ! [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "agentbox: invalid variable name in AGENTBOX_SHARE_DIRS: $name" >&2
    exit 1
  fi
  dir="${!name-}"
  [[ -z "$dir" ]] && continue
  if ! [[ -d "$dir" ]]; then
    echo "agentbox: $name=$dir is not a directory; not sharing it" >&2
    continue
  fi
  vm_env+=("$name=$dir")
  shared_dirs+=(-v "$dir:$dir:ro")
done

# Per-project ~/.cache, so one project's session can't poison another's.
# Admin mode gets its own, so agents can't plant downloads that admin
# mise installs put into the shared toolchains. Name: the path made
# filename-safe, plus a hash to keep paths like /a/b-c and /a/b/c apart.
if [[ -n "$is_admin" ]]; then
  cache_dir="$AGENTBOX_DATA_DIR/cache/admin"
else
  cache_name=$(printf '%s' "${PWD#/}" | tr -c 'A-Za-z0-9._-' '-')
  cache_hash=$(printf '%s' "$PWD" | sha256sum | cut -c1-8)
  cache_dir="$AGENTBOX_DATA_DIR/cache/projects/$cache_name-$cache_hash"
fi
mkdir -p "$cache_dir"

# Pass the tokens to msb as secrets, under the names gh, Claude Code,
# gcloud and Terraform read. The AGENTBOX_ prefix keeps them apart from
# any GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN or CLOUDSDK_AUTH_ACCESS_TOKEN set
# on the host for other uses.
gh_token="${AGENTBOX_GH_TOKEN-}"
claude_token="${AGENTBOX_CLAUDE_CODE_OAUTH_TOKEN-}"
google_token="${AGENTBOX_CLOUDSDK_AUTH_ACCESS_TOKEN-}"
secrets=()
[[ -n "$gh_token" ]] && secrets+=(--secret "GH_TOKEN@api.github.com,github.com")
[[ -n "$claude_token" ]] && secrets+=(--secret "CLAUDE_CODE_OAUTH_TOKEN@api.anthropic.com")
[[ -n "$google_token" ]] && secrets+=(
  --secret "CLOUDSDK_AUTH_ACCESS_TOKEN@*.googleapis.com"
  --secret "GOOGLE_OAUTH_ACCESS_TOKEN@*.googleapis.com"
)

# Read-only .git so the agent can't plant hooks or config that run on the host.
git_ro=()
[[ -d "$PWD/.git" ]] && git_ro=(-v "$PWD/.git:$PWD/.git:ro")

# Same-path mount keeps file paths and Claude Code's per-project state
# identical inside and outside the VM.
exec env \
  GH_TOKEN="$gh_token" \
  CLAUDE_CODE_OAUTH_TOKEN="$claude_token" \
  CLOUDSDK_AUTH_ACCESS_TOKEN="$google_token" \
  GOOGLE_OAUTH_ACCESS_TOKEN="$google_token" \
  msb run \
  -c 2 -m 4G \
  "${secrets[@]}" \
  -v "$AGENTBOX_DATA_DIR/claude:/home/agent/.claude" \
  -v "$mise_dir/data:/home/agent/.local/share/mise$mise_mount_suffix" \
  -v "$mise_dir/config:/home/agent/.config/mise$mise_mount_suffix" \
  -v "$mise_dir/state:/home/agent/.local/state/mise$mise_mount_suffix" \
  -v "$cache_dir:/home/agent/.cache" \
  -v "$PWD:$PWD" -w "$PWD" \
  "${git_ro[@]}" \
  "${shared_dirs[@]}" \
  localhost/agentbox:latest -- env "${vm_env[@]}" "$@"
